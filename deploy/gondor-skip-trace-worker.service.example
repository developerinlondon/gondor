[Unit]
Description=gondor · fcar.skip-trace worker
After=gondor.service
Wants=gondor.service

[Service]
Type=simple
User=gondor
Group=gondor

EnvironmentFile=/etc/gondor/env

ExecStart=/bin/sh -c 'set -a; \
  export ASSAY_ADMIN_KEY="$GONDOR_ADMIN_API_KEYS"; \
  export ASSAY_ENGINE_URL="${ENGINE_URL:-http://127.0.0.1:8080}"; \
  exec /usr/local/bin/assay run /etc/gondor/scripts/skip_trace_worker.lua'

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true

[Install]
WantedBy=multi-user.target
