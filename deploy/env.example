# /etc/gondor/env — sourced by the systemd unit.
#
# These are SECRETS. Keep mode 0600 + chown root:gondor.
# Rotate by editing this file and `systemctl restart gondor`.

# Comma-separated list of admin API keys accepted by the engine sidecar.
# Generate with: openssl rand -hex 32
GONDOR_ADMIN_API_KEYS=

# Engine sidecar URL the consumer app talks to (workflow create, vault
# reads, audit-log push). The gondor-engine.service unit binds
# 127.0.0.1:8082 — see deploy/engine.toml.example.
ENGINE_URL=http://127.0.0.1:8082

# Public URL of the engine SPA (auth/vault/workflow consoles). Surfaced
# as the "Engine" sidebar link in gondor's sysops layout, the
# "Open in engine ↗" button on /skip-trace, and the "Open vault →"
# buttons on the backups page.
#
# When AUTH_ISSUER below is set, the dashboard SPAs are proxied through
# gondor.agenteda.com via the sysops 0.2.0 auth gateway and this var is
# only the link target for "open externally" buttons. The browser never
# hits gondor-engine.agenteda.com directly for admin operations.
ENGINE_BASE_URL=https://gondor-engine.agenteda.com

# HTTP port gondor binds on. Front it with cloudflared or Traefik in
# production (the unit binds 127.0.0.1 by default — see the unit file).
PORT=18786

# Brand pack directory. /etc/gondor/brand on a normal install.
BRAND_DIR=/etc/gondor/brand

# Sysops lib install dir. `assay install` writes here from Manifest.lua.
SYSOPS_LIB_ROOT=/opt/assay/libs/sysops

# Gondor app root (templates/, services/, pages/ live here).
GONDOR_ROOT=/etc/gondor

# Token used by `mise install` to pull the assay release. Personal
# Access Token with `repo:read` scope. Only needed during install.
GITHUB_TOKEN=

# =============================================================================
# Sysops 0.2.0 auth gateway (optional — opt in by setting AUTH_ISSUER).
# When configured, gondor.agenteda.com becomes the OIDC RP + front door
# for the engine; dashboard SPAs and /api/v1/engine/* are proxied with
# admin-bearer injection. The browser only ever sees a HttpOnly session
# cookie; the engine bearer never leaves the gondor host.
# =============================================================================

# OIDC issuer URL. Points at assay-auth's OIDC IdP on the engine sidecar,
# reachable via the engine's public hostname (the browser is redirected
# there for the authorize step).
AUTH_ISSUER=https://gondor-engine.agenteda.com/auth

# OAuth2 client id (must be registered on the IdP via the admin API or
# sysops's /auth/oidc-clients page).
AUTH_CLIENT_ID=gondor-dashboard

# Callback URL the IdP redirects to. Must match exactly what's
# registered on the IdP side.
AUTH_REDIRECT_URI=https://gondor.agenteda.com/auth/callback

# Session cookie signing key. ≥32 bytes random.
# Generate with: openssl rand -hex 32
SYSOPS_SESSION_KEY=

# Optional: session TTL in seconds (default 86400 = 24h).
AUTH_SESSION_TTL=86400
